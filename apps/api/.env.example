# Copy to apps/api/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase PostgreSQL connection string.
# Prefer the Supabase connection pooler for serverless/high-concurrency workloads.
# For a long-running Railway service, use the connection option recommended by Supabase.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Reserved for the WhatsApp integration phase. Do not populate until Meta setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# Reserved for the AI integration phase.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EXTRACTION_MODEL=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Temporary media lifecycle; implementation arrives in the voice phase.
MEDIA_RETENTION_HOURS=24
