  "description": "BUSHO (Bottom-Up Smart Health Orchestrator): a dependency-free first-mile health reporting prototype. Synthetic data only.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirtanswamy/BUSHO.git"
  },
